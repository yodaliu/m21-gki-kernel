From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chetan C R <quic_cchinnad@quicinc.com>
Date: Tue, 14 Feb 2023 11:52:28 +0530
Subject: [PATCH 01/15] clk: qcom: gcc-khaje: Use floor ops for SDCC clocks

To avoid overclocking issues observed on few parts,
use floor ops for SDCC clocks.

Change-Id: I82faf84486a66fe04c51c2a1c63b989725113e38
Signed-off-by: Chetan C R <quic_cchinnad@quicinc.com>
---
 drivers/clk/qcom/gcc-khaje.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/qcom/gcc-khaje.c b/drivers/clk/qcom/gcc-khaje.c
index 271677acf5e..3b91db47c94 100644
--- a/drivers/clk/qcom/gcc-khaje.c
+++ b/drivers/clk/qcom/gcc-khaje.c
@@ -1,6 +1,6 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Copyright (c) 2022, Qualcomm Innovation Center, Inc. All rights reserved.
+ * Copyright (c) 2022-2023, Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
 #include <linux/clk.h>
@@ -1715,7 +1715,7 @@ static struct clk_rcg2 gcc_sdcc1_apps_clk_src = {
 		.parent_data = gcc_parent_data_1,
 		.num_parents = ARRAY_SIZE(gcc_parent_data_1),
 		.flags = CLK_OPS_PARENT_ENABLE,
-		.ops = &clk_rcg2_ops,
+		.ops = &clk_rcg2_floor_ops,
 	},
 	.clkr.vdd_data = {
 		.vdd_class = &vdd_cx,
@@ -1746,7 +1746,7 @@ static struct clk_rcg2 gcc_sdcc1_ice_core_clk_src = {
 		.parent_data = gcc_parent_data_0,
 		.num_parents = ARRAY_SIZE(gcc_parent_data_0),
 		.flags = CLK_SET_RATE_PARENT,
-		.ops = &clk_rcg2_ops,
+		.ops = &clk_rcg2_floor_ops,
 	},
 	.clkr.vdd_data = {
 		.vdd_class = &vdd_cx,
