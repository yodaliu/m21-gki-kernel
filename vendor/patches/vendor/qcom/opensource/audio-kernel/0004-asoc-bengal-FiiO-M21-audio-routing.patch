 	if (!bolero_component) {
 		pr_err("%s: could not find component for bolero_codec\n",
 			__func__);
 		return -EINVAL;
 	}
-	pr_err("%s:: bolero comp lookup done\n", __func__);
-
 	dapm = snd_soc_component_get_dapm(bolero_component);
 	snd_soc_dapm_new_controls(dapm, msm_int_dapm_widgets,
 		ARRAY_SIZE(msm_int_dapm_widgets));
-	pr_err("%s:: dapm new controls msm_int_dapm_widgets \n", __func__);
 
 	snd_soc_dapm_ignore_suspend(dapm, "Digital Mic0");
 	snd_soc_dapm_ignore_suspend(dapm, "Digital Mic1");
@@ -1198,6 +1247,14 @@ static int msm_rx_tx_codec_init(struct snd_soc_pcm_runtime *rtd)
 	bolero_info_create_codec_entry(pdata->codec_root, bolero_component);
 	bolero_register_wake_irq(bolero_component, false);
 
+	if (pdata->wcd_disabled) {
+		bolero_set_port_map(bolero_component,
+			ARRAY_SIZE(sm_port_map),
+			sm_port_map);
+		codec_reg_done = true;
+		return 0;
+	}
+
 	component = snd_soc_rtdcom_lookup(rtd, WCD937X_DRV_NAME);
 	if (!component)
 		component = snd_soc_rtdcom_lookup(rtd, DRV_NAME);
@@ -1207,6 +1264,13 @@ static int msm_rx_tx_codec_init(struct snd_soc_pcm_runtime *rtd)
 		return -EINVAL;
 	}
 
+	ret = snd_soc_add_component_controls(component, msm_int_snd_controls,
+					     ARRAY_SIZE(msm_int_snd_controls));
+	if (ret < 0) {
+		pr_err("%s: add_component_controls failed: %d\n", __func__, ret);
+		return ret;
+	}
+
 	dapm = snd_soc_component_get_dapm(component);
 	card = component->card->snd_card;
 
@@ -1410,6 +1474,9 @@ static int msm_asoc_machine_probe(struct platform_device *pdev)
 	if (!pdata)
 		return -ENOMEM;
 
+	of_property_read_u32(pdev->dev.of_node, "qcom,wcd-disabled",
+			     &pdata->wcd_disabled);
+
 	card = populate_snd_card_dailinks(&pdev->dev);
 	if (!card) {
 		dev_err(&pdev->dev, "%s: Card uninitialized\n", __func__);
@@ -1441,6 +1508,10 @@ static int msm_asoc_machine_probe(struct platform_device *pdev)
 		goto err;
 	}
 
+	if (is_ext_spk_gpio_support(pdev) < 0)
+		dev_err(&pdev->dev, "%s: doesn't support external speaker pa or codec is not wcd937x\n",
+			__func__);
+
         /* Get maximum WSA device count for this platform */
 	ret = of_property_read_u32(pdev->dev.of_node,
 		"qcom,wsa-max-devs", &pdata->wsa_max_devs);
