 };
 
 static bool va_disable;
@@ -293,6 +294,59 @@ static struct snd_info_entry *msm_snd_info_create_subdir(struct module *mod,
         return entry;
 }
 
+/* external speaker amplifier enable GPIO, switched by the "Ext_Spk_Switch" mixer control */
+static int ext_spk_gpio = -1;
+static int ext_spk_switch_value;
+static const char *const ext_spk_switch[] = {"Off", "On"};
+static const struct soc_enum ext_speaker_gpio_ctrl =
+	SOC_ENUM_SINGLE_EXT(ARRAY_SIZE(ext_spk_switch), ext_spk_switch);
+
+static int ext_spk_switch_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = ext_spk_switch_value;
+	return 0;
+}
+
+static int ext_spk_switch_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	ext_spk_switch_value = ucontrol->value.integer.value[0];
+	if (ext_spk_gpio < 0) {
+		pr_err("%s: get control external PA gpio failed\n", __func__);
+		return 0;
+	}
+	if (ext_spk_switch_value)
+		gpio_set_value(ext_spk_gpio, 1);
+	else
+		gpio_set_value(ext_spk_gpio, 0);
+	return 0;
+}
+
+static const struct snd_kcontrol_new msm_int_snd_controls[] = {
+	SOC_ENUM_EXT("Ext_Spk_Switch", ext_speaker_gpio_ctrl,
+		     ext_spk_switch_get, ext_spk_switch_put),
+};
+
+int is_ext_spk_gpio_support(struct platform_device *pdev)
+{
+	const char *spk_ext_pa = "qcom,msm-spk-ext-pa";
+
+	ext_spk_gpio = of_get_named_gpio(pdev->dev.of_node, spk_ext_pa, 0);
+	if (ext_spk_gpio < 0) {
+		dev_err(&pdev->dev, "%s: missing %s in dt node\n", __func__,
+			spk_ext_pa);
+		return -EINVAL;
+	}
+	if (!gpio_is_valid(ext_spk_gpio)) {
+		dev_err(&pdev->dev, "%s: Invalid external speaker gpio: %d",
+			__func__, ext_spk_gpio);
+		return -EINVAL;
+	}
+	gpio_request_one(ext_spk_gpio, GPIOF_OUT_INIT_LOW, "ext_spk_gpio");
+	return 0;
+}
+
 static void *def_wcd_mbhc_cal(void)
 {
 	void *wcd_mbhc_cal;
@@ -1155,20 +1209,15 @@ static int msm_rx_tx_codec_init(struct snd_soc_pcm_runtime *rtd)
 	struct msm_asoc_mach_data *pdata =
 			snd_soc_card_get_drvdata(rtd->card);
 
-	pr_err("%s:: enter \n", __func__);
-
