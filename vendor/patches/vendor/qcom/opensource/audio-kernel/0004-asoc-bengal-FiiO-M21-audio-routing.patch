 asoc/msm-audio-defs.h     |  4 +-
 asoc/msm_bengal_dailink.h | 11 +++---
 asoc/msm_common.c         | 43 ++++++++++++++++++++-
 asoc/msm_common.h         |  1 +
 5 files changed, 126 insertions(+), 14 deletions(-)

diff --git a/asoc/bengal.c b/asoc/bengal.c
index d7b3ffee..dfcb0968 100644
--- a/asoc/bengal.c
+++ b/asoc/bengal.c
@@ -77,6 +77,7 @@ struct msm_asoc_mach_data {
