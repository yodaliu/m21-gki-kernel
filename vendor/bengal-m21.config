# Applied on top of msm-kernel gki_defconfig + arch/arm64/configs/vendor/bengal_GKI.config
# (the same base Qualcomm's build.config.msm.bengal uses) by scripts/build-vendor-modules.sh.
#
# Needed by the stock module set but not in the public bengal fragment:
CONFIG_FPGA=m
# Build-host knobs (do not change module code or CRCs):
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_MODULE_SIG is not set
# DEBUG_INFO_BTF must stay on: DEBUG_INFO_BTF_MODULES adds btf_data/btf_data_size to struct module, and
# without them about 8,800 KMI symbol CRCs change (module_layout included).  New pahole versions are handled
# by the wrapper in scripts/build-vendor-modules.sh.
